# Configuración de Base de Datos
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=formopack_db

# Seguridad Flask (Cambiar en producción)
SECRET_KEY=clave_secreta_para_desarrollo_local

# Integración Gmail (alertas operativas)
# GMAIL_APP_PASSWORD debe ser una contraseña de aplicación de Google, no la contraseña normal.
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=465
GMAIL_USER=tu_correo@gmail.com
GMAIL_APP_PASSWORD=tu_contrasena_de_aplicacion
ALERTAS_EMAIL=destinatario@gmail.com

# Integración Mercado Pago (Checkout Pro)
MP_ACCESS_TOKEN=APP_USR-tu_access_token_de_prueba
MP_COLLECTOR_ID=
MP_WEBHOOK_SECRET=
MP_TEST_MODE=true
MP_BASE_URL=http://localhost:5050
